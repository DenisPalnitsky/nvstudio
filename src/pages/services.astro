---
import BaseLayout from "../layouts/BaseLayout.astro";
const baseUrl = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
  title="Services - NV Studio Design"
  description="Architectural Design, Interior Design, and Planning & Permits for residential projects across the GTA and Ontario. Three integrated services, one practice."
>
  <section id="one">
    <div class="inner">
      <header class="major">
        <h1>Services</h1>
      </header>

      <p>
        Three services, one practice. Every residential project we take on
        moves through some combination of the three, coordinated end to end
        so nothing gets lost in the handoff between design and permit, or
        architecture and interiors.
      </p>

      <div class="row gtr-50 gtr-uniform">
        <div class="col-4 col-12-medium">
          <article class="project-card">
            <header class="major">
              <h2><a href={`${baseUrl}architectural-design`}>Architectural Design</a></h2>
            </header>
            <p>
              Custom homes, renovations, and additions across the GTA and
              Ontario &mdash; from concept through design development,
              permit drawings, and construction support. Zoning and
              feasibility are part of the service, not a separate step.
            </p>
            <ul class="actions">
              <li><a href={`${baseUrl}architectural-design`} class="button">Learn more</a></li>
            </ul>
          </article>
        </div>

        <div class="col-4 col-12-medium">
          <article class="project-card">
            <header class="major">
              <h2><a href={`${baseUrl}interior-design`}>Interior Design</a></h2>
            </header>
            <p>
              Residential interiors developed alongside the architecture:
              space planning, materials and finishes, built-ins, kitchens,
              and bathrooms. Available as part of a full project or as a
              standalone interior engagement.
            </p>
            <ul class="actions">
              <li><a href={`${baseUrl}interior-design`} class="button">Learn more</a></li>
            </ul>
          </article>
        </div>

        <div class="col-4 col-12-medium">
          <article class="project-card">
            <header class="major">
              <h2><a href={`${baseUrl}building-permits`}>Planning &amp; Building Permits</a></h2>
            </header>
            <p>
              Zoning review, feasibility studies, and permit drawings for
              Ontario municipalities &mdash; including additions, secondary
              suites, and laneway houses. The quiet, technical work that
              gets projects approved.
            </p>
            <ul class="actions">
              <li><a href={`${baseUrl}building-permits`} class="button">Learn more</a></li>
            </ul>
          </article>
        </div>
      </div>

      <p>
        Not sure which service fits your project? A short
        <a href={`${baseUrl}contact`}>consultation</a> is usually the
        quickest way to find out.
      </p>
    </div>
  </section>
</BaseLayout>
