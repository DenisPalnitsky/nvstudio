---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Modern Residential Villa - NV Studio Design"
  description="Modern Residential Villa - A stunning contemporary home featuring clean lines, floor-to-ceiling windows, and sustainable design elements by NV Studio Design."
  keywords="modern residential villa, contemporary home design, architectural design, NV Studio Design"
  headerClass="alt style2"
  mainClass={undefined}
>
  <section id="banner" class="style2" slot="banner">
    <div class="inner">
      <span class="image">
        <img
          src="images/projects/modern-residential-villa/1-m5KLpxQggBCWDKl6.jpg"
          alt="Modern Residential Villa"
        />
      </span>
      <header class="major">
        <h1>Modern Residential Villa</h1>
      </header>
      <div class="content">
        <p>
          A stunning contemporary home featuring clean lines,<br />
          floor-to-ceiling windows, and sustainable design elements.
        </p>
      </div>
    </div>
  </section>

  <section id="one">
    <div class="inner">
      <header class="major">
        <!-- Content from docs/pages.md Section 8: Individual Project Pages (lines 183-204) -->
        <h2>Individual Project Page Template</h2>
      </header>

      <h3>Purpose</h3>
      <ul>
        <li>Strongest SEO + trust asset</li>
        <li>Prove real experience</li>
      </ul>

      <h3>Content recommendations</h3>
      <ul>
        <li>Project title + year</li>
        <li>City (not exact address)</li>
        <li>Client goals</li>
        <li>Design challenges</li>
        <li>Plans / drawings / renders</li>
        <li>Short narrative</li>
      </ul>

      <h3>Implementation notes</h3>
      <ul>
        <li>One URL per project</li>
        <li>Text is mandatory (not image-only)</li>
        <li>Use consistent structure for all projects</li>
      </ul>

      <ul class="actions">
        <li><a href="portfolio.html" class="button primary">Back to Portfolio</a></li>
        <li><a href="contact.html" class="button">Start Your Project</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>

