---
import BaseLayout from "../layouts/BaseLayout.astro";
const baseUrl = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
  title="Modern Residential Villa - NV Studio Design"
  description="A contemporary custom home in the Greater Toronto Area by NV Studio Design. Clean lines, generous glazing, and a plan shaped by site and orientation."
  keywords="modern residential villa Toronto, custom home GTA, contemporary architecture Ontario, NV Studio Design"
  headerClass="alt style2"
  mainClass={undefined}
>
  <section id="banner" class="style2" slot="banner">
    <div class="inner">
      <span class="image">
        <img
          src="images/projects/modern-residential-villa/1-m5KLpxQggBCWDKl6.jpg"
          alt="Modern residential villa, a contemporary custom home by NV Studio Design"
        />
      </span>
      <header class="major">
        <h1>Modern Residential Villa</h1>
      </header>
      <div class="content">
        <p>
          A contemporary custom home designed around clean lines,<br />
          generous glazing, and the way the family actually lives.
        </p>
      </div>
    </div>
  </section>

  <section id="one">
    <div class="inner">
      <div class="row gtr-50">
        <div class="col-8 col-12-medium">
          <h2>Design intent</h2>
          <p>
            The house is organised around a clear, legible plan: a quiet
            front face, an open living volume behind it, and a private zone
            above. Floor-to-ceiling glazing opens the main floor to the
            garden and brings daylight deep into the plan; solid wall
            elements hold the composition together and keep the street
            elevation calm.
          </p>
          <p>
            Materials were chosen to age well on a GTA site: warm-toned
            cladding, dark-framed fenestration, and restrained
            detailing. The interior continues the same vocabulary &mdash;
            architectural millwork, integrated lighting, and a small
            palette of surfaces carried through from entry to principal
            suite.
          </p>

          <h2>Key ideas</h2>
          <ul>
            <li>A compact, rational plan that reads at a glance.</li>
            <li>Glazing placed for light and view, not for symmetry.</li>
            <li>Interior and architecture designed as one project, so cabinetry and lighting resolve cleanly into the structure.</li>
            <li>Massing and setbacks worked out against the lot&rsquo;s zoning early, not revised under permit pressure.</li>
          </ul>
        </div>

        <div class="col-4 col-12-medium">
          <h3>Project facts</h3>
          <ul>
            <li><strong>Type:</strong> Custom home</li>
            <li><strong>Location:</strong> {"{{ city — e.g. Toronto, Mississauga, Oakville }}"}</li>
            <li><strong>Year:</strong> {"{{ year }}"}</li>
            <li><strong>Size:</strong> {"{{ size_sqft }}"}</li>
            <li><strong>Status:</strong> {"{{ status — completed / under construction / permitted }}"}</li>
            <li><strong>Services:</strong> Architectural design, interior design, permits</li>
          </ul>

          <h3>Client brief</h3>
          <p>
            {"{{ client_goal — 1 to 2 sentences. Fill from content questionnaire. }}"}
          </p>

          <h3>Design challenge</h3>
          <p>
            {"{{ design_challenge — 1 to 2 sentences. Fill from content questionnaire. }}"}
          </p>
        </div>
      </div>

      <!--
        Additional project images can be added here. Files live at:
        /public/images/projects/modern-residential-villa/
        Known files: 1-m5KLpxQggBCWDKl6.jpg, img-A0xxQVDK1eT4vp13.jpg, QIP-Shot-Screen-mePjwaZBlNi3jZze.jpg
      -->

      <ul class="actions">
        <li><a href={`${baseUrl}portfolio`} class="button primary">Back to Portfolio</a></li>
        <li><a href={`${baseUrl}contact`} class="button">Start Your Project</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>
