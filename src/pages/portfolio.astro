---
import BaseLayout from "../layouts/BaseLayout.astro";
const baseUrl = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
  title="Portfolio - NV Studio Design"
  description="Selected residential architecture and interior design projects by NV Studio Design across the Greater Toronto Area and Ontario."
>
  <section id="one">
    <div class="inner">
      <header class="major">
        <h1>Portfolio</h1>
      </header>

      <p>
        A selection of residential projects &mdash; custom homes,
        renovations, interiors, and secondary suites &mdash; across the
        Greater Toronto Area and Ontario. Each project page has a short
        write-up alongside the images: goals, constraints, and the design
        decisions that shaped the result.
      </p>

      <div class="row gtr-50 gtr-uniform">
        <div class="col-6 col-12-medium">
          <article class="project-card">
            <a href={`${baseUrl}project-modern-residential-villa`} class="image">
              <img
                src="images/projects/modern-residential-villa/1-m5KLpxQggBCWDKl6.jpg"
                alt="Modern residential villa, custom home by NV Studio Design, Greater Toronto Area"
              />
            </a>
            <header class="major">
              <h3><a href={`${baseUrl}project-modern-residential-villa`}>Modern Residential Villa</a></h3>
              <p>Custom home &middot; Greater Toronto Area</p>
            </header>
          </article>
        </div>
        <div class="col-6 col-12-medium">
          <article class="project-card">
            <a href={`${baseUrl}project-contemporary-kitchen-design`} class="image">
              <img
                src="images/projects/contemporary-kitchen-design/4-5-mxB1570PnXh3MKp8.jpg"
                alt="Contemporary kitchen design with premium finishes by NV Studio Design, GTA"
              />
            </a>
            <header class="major">
              <h3><a href={`${baseUrl}project-contemporary-kitchen-design`}>Contemporary Kitchen Design</a></h3>
              <p>Kitchen renovation &middot; GTA</p>
            </header>
          </article>
        </div>
        <div class="col-6 col-12-medium">
          <article class="project-card">
            <a href={`${baseUrl}project-luxury-home-renovation`} class="image">
              <img
                src="images/projects/luxury-home-renovation/3-A3QOoKVygoIkW0VX.jpg"
                alt="Whole-house renovation of a 1980s residence by NV Studio Design, GTA"
              />
            </a>
            <header class="major">
              <h3><a href={`${baseUrl}project-luxury-home-renovation`}>Luxury Home Renovation</a></h3>
              <p>Whole-house renovation &middot; GTA</p>
            </header>
          </article>
        </div>
        <div class="col-6 col-12-medium">
          <article class="project-card">
            <a href={`${baseUrl}project-laneway-house`} class="image">
              <img
                src="images/projects/laneway-house-project/1a-YD0ng4naVrtpzOMo.jpg"
                alt="Compact 850 square foot laneway house by NV Studio Design, Toronto"
              />
            </a>
            <header class="major">
              <h3><a href={`${baseUrl}project-laneway-house`}>Laneway House</a></h3>
              <p>Secondary dwelling &middot; Toronto</p>
            </header>
          </article>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
