---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Portfolio - NV Studio Design"
  description="NV Studio Design portfolio - Explore our residential architecture projects in the GTA and Ontario."
>
  <section id="one">
    <div class="inner">
      <header class="major">
        <h1>Portfolio</h1>
      </header>

      <!-- Placeholder Content - TO BE REPLACED -->
      <div
        style="background: #fff; color: #333; padding: 2rem; border: 2px dashed #ccc; border-radius: 4px; font-family: monospace; font-size: 14px; line-height: 1.8;"
      >
        <p style="color: #e74c3c; font-weight: bold; margin-bottom: 1rem;">
          📋 TODO for Portfolio section
        </p>

        <p><strong>Purpose</strong></p>
        <ul>
          <li>Showcase work</li>
          <li>Funnel users to project pages</li>
        </ul>

        <p><strong>Content recommendations</strong></p>
        <ul>
          <li>Grid of projects</li>
          <li>
            Filters:
            <ul>
              <li>Year</li>
              <li>Project type (optional)</li>
            </ul>
          </li>
        </ul>

        <p><strong>Implementation notes</strong></p>
        <ul>
          <li>Each project must link to its own page</li>
          <li>Avoid infinite scroll without pagination</li>
        </ul>
      </div>

      <!-- Project Grid (functional links) -->
      <h2 style="margin-top: 2rem;">Projects</h2>
      <div class="row gtr-50 gtr-uniform">
        <div class="col-6 col-12-medium">
          <article class="project-card">
            <a href="/project-modern-residential-villa" class="image">
              <img
                src="images/projects/modern-residential-villa/1-m5KLpxQggBCWDKl6.jpg"
                alt="Modern Residential Villa"
              />
            </a>
            <header class="major">
              <h3><a href="/project-modern-residential-villa">Modern Residential Villa</a></h3>
            </header>
          </article>
        </div>
        <div class="col-6 col-12-medium">
          <article class="project-card">
            <a href="/project-contemporary-kitchen-design" class="image">
              <img
                src="images/projects/contemporary-kitchen-design/4-5-mxB1570PnXh3MKp8.jpg"
                alt="Contemporary Kitchen Design"
              />
            </a>
            <header class="major">
              <h3><a href="/project-contemporary-kitchen-design">Contemporary Kitchen Design</a></h3>
            </header>
          </article>
        </div>
        <div class="col-6 col-12-medium">
          <article class="project-card">
            <a href="/project-luxury-home-renovation" class="image">
              <img
                src="images/projects/luxury-home-renovation/3-A3QOoKVygoIkW0VX.jpg"
                alt="Luxury Home Renovation"
              />
            </a>
            <header class="major">
              <h3><a href="/project-luxury-home-renovation">Luxury Home Renovation</a></h3>
            </header>
          </article>
        </div>
        <div class="col-6 col-12-medium">
          <article class="project-card">
            <a href="/project-laneway-house" class="image">
              <img
                src="images/projects/laneway-house-project/1a-YD0ng4naVrtpzOMo.jpg"
                alt="Laneway House Project"
              />
            </a>
            <header class="major">
              <h3><a href="/project-laneway-house">Laneway House Project</a></h3>
            </header>
          </article>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

