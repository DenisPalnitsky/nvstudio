---
import BaseLayout from "../layouts/BaseLayout.astro";
const baseUrl = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
  title="Laneway House - NV Studio Design"
  description="An 850 sq ft laneway house by NV Studio Design. A compact Toronto laneway suite designed for real living &mdash; tight zoning, generous light, careful plan."
  keywords="laneway house Toronto, laneway suite Toronto, secondary dwelling unit Ontario, small space architecture, NV Studio Design"
  headerClass="alt style2"
  mainClass={undefined}
>
  <section id="banner" class="style2" slot="banner">
    <div class="inner">
      <span class="image">
        <img
          src="images/projects/laneway-house-project/1a-YD0ng4naVrtpzOMo.jpg"
          alt="Compact 850 square foot laneway house by NV Studio Design, Toronto"
        />
      </span>
      <header class="major">
        <h1>Laneway House</h1>
      </header>
      <div class="content">
        <p>
          An 850 sq ft laneway house in Toronto &mdash;<br />
          compact on the lot, generous on light, tuned to the by-law.
        </p>
      </div>
    </div>
  </section>

  <section id="one">
    <div class="inner">
      <div class="row gtr-50">
        <div class="col-8 col-12-medium">
          <h2>Design intent</h2>
          <p>
            Laneway suites are among the most constrained residential
            projects Toronto allows: a specific by-law, strict angular
            plane rules, and a footprint measured in feet. That&rsquo;s
            also what makes them interesting &mdash; every decision
            counts, and nothing can be fudged.
          </p>
          <p>
            The plan puts living and kitchen on the main level with a
            double-height moment where it matters, and a private sleeping
            zone above. Windows were placed for light and privacy, not
            for composition &mdash; laneway neighbours are close, and
            openings that work in a single-family suburb don&rsquo;t work
            here. The result is a small house that still feels like a
            house.
          </p>

          <h2>Key ideas</h2>
          <ul>
            <li>Every square foot earns its place; nothing is leftover space.</li>
            <li>Designed against Toronto&rsquo;s laneway by-law from the first sketch.</li>
            <li>Storage built into the architecture, not appliqued on after.</li>
            <li>Glazing tuned for privacy from laneway and main house alike.</li>
          </ul>
        </div>

        <div class="col-4 col-12-medium">
          <h3>Project facts</h3>
          <ul>
            <li><strong>Type:</strong> Laneway suite (secondary dwelling)</li>
            <li><strong>Location:</strong> Toronto {"{{ confirm_city }}"}</li>
            <li><strong>Year:</strong> {"{{ year }}"}</li>
            <li><strong>Size:</strong> 850 sq ft {"{{ confirm_size }}"}</li>
            <li><strong>Status:</strong> {"{{ status }}"}</li>
            <li><strong>Services:</strong> Architectural design, permits, zoning</li>
          </ul>

          <h3>Client brief</h3>
          <p>
            {"{{ client_goal — 1 to 2 sentences. Fill from content questionnaire. }}"}
          </p>

          <h3>Design challenge</h3>
          <p>
            {"{{ design_challenge — 1 to 2 sentences. Fill from content questionnaire. }}"}
          </p>
        </div>
      </div>

      <!--
        Additional images available in /public/images/projects/laneway-house-project/
        Known files: 1a-YD0ng4naVrtpzOMo.jpg, img-dWxq59JboXf78PDJ.jpg
      -->

      <ul class="actions">
        <li><a href={`${baseUrl}portfolio`} class="button primary">Back to Portfolio</a></li>
        <li><a href={`${baseUrl}contact`} class="button">Start Your Project</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>
