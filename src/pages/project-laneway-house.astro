---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Laneway House Project - NV Studio Design"
  description="Laneway House Project - A modern 850 sq ft laneway house designed for urban living by NV Studio Design."
  keywords="laneway house, secondary dwelling unit, urban design, small space design, NV Studio Design"
  headerClass="alt style2"
  mainClass={undefined}
>
  <section id="banner" class="style2" slot="banner">
    <div class="inner">
      <span class="image">
        <img
          src="images/projects/laneway-house-project/1a-YD0ng4naVrtpzOMo.jpg"
          alt="Laneway House Project"
        />
      </span>
      <header class="major">
        <h1>Laneway House Project</h1>
      </header>
      <div class="content">
        <p>
          A modern 850 sq ft laneway house designed for urban living,<br />
          maximizing space efficiency while maintaining style and comfort.
        </p>
      </div>
    </div>
  </section>

  <section id="one">
    <div class="inner">
      <header class="major">
        <!-- Content from docs/pages.md Section 8: Individual Project Pages (lines 183-204) -->
        <h2>Individual Project Page Template</h2>
      </header>

      <h3>Purpose</h3>
      <ul>
        <li>Strongest SEO + trust asset</li>
        <li>Prove real experience</li>
      </ul>

      <h3>Content recommendations</h3>
      <ul>
        <li>Project title + year</li>
        <li>City (not exact address)</li>
        <li>Client goals</li>
        <li>Design challenges</li>
        <li>Plans / drawings / renders</li>
        <li>Short narrative</li>
      </ul>

      <h3>Implementation notes</h3>
      <ul>
        <li>One URL per project</li>
        <li>Text is mandatory (not image-only)</li>
        <li>Use consistent structure for all projects</li>
      </ul>

      <ul class="actions">
        <li><a href="/portfolio" class="button primary">Back to Portfolio</a></li>
        <li><a href="/contact" class="button">Start Your Project</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>

