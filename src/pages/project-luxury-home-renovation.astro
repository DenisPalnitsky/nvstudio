---
import BaseLayout from "../layouts/BaseLayout.astro";
const baseUrl = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
  title="Luxury Home Renovation - NV Studio Design"
  description="A whole-house renovation of a 1980s home by NV Studio Design. A reworked plan, new envelope details, and interiors designed alongside the architecture."
  keywords="home renovation Toronto, whole house renovation GTA, 1980s home renovation Ontario, NV Studio Design"
  headerClass="alt style2"
  mainClass={undefined}
>
  <section id="banner" class="style2" slot="banner">
    <div class="inner">
      <span class="image">
        <img
          src="images/projects/luxury-home-renovation/3-A3QOoKVygoIkW0VX.jpg"
          alt="Whole-house renovation of a 1980s residence by NV Studio Design"
        />
      </span>
      <header class="major">
        <h1>Luxury Home Renovation</h1>
      </header>
      <div class="content">
        <p>
          A 1980s home reworked from the inside out &mdash;<br />
          new plan, new envelope, interiors built with the architecture.
        </p>
      </div>
    </div>
  </section>

  <section id="one">
    <div class="inner">
      <div class="row gtr-50">
        <div class="col-8 col-12-medium">
          <h2>Design intent</h2>
          <p>
            Post-1980s houses usually have good bones and awkward plans.
            The approach here was to keep the structure working for us,
            rebuild the plan around how the owners actually use the
            house, and refresh the envelope and interior in one
            coordinated pass.
          </p>
          <p>
            On the main floor that meant opening the kitchen and living
            areas into one connected volume, re-proportioning windows to
            bring in more daylight, and reworking circulation so every
            room has a clear purpose. Upstairs the plan was tightened to
            give each bedroom a proper envelope and the principal suite
            a full bath and dressing area.
          </p>

          <h2>Key ideas</h2>
          <ul>
            <li>Keep what&rsquo;s sound in the original structure; rebuild what isn&rsquo;t.</li>
            <li>Architecture and interiors designed together, so finishes resolve into the built form.</li>
            <li>A single, disciplined material palette from entry to upstairs.</li>
            <li>Construction sequenced so the family could plan their decant and return with confidence.</li>
          </ul>
        </div>

        <div class="col-4 col-12-medium">
          <h3>Project facts</h3>
          <ul>
            <li><strong>Type:</strong> Whole-house renovation</li>
            <li><strong>Original build:</strong> {"{{ original_era — currently \"1980s\", confirm }}"}</li>
            <li><strong>Location:</strong> {"{{ city }}"}</li>
            <li><strong>Year renovated:</strong> {"{{ year }}"}</li>
            <li><strong>Size:</strong> {"{{ size_sqft_before }} / {{ size_sqft_after }}"}</li>
            <li><strong>Status:</strong> {"{{ status }}"}</li>
            <li><strong>Services:</strong> Architectural design, interior design, permits</li>
          </ul>

          <h3>Client brief</h3>
          <p>
            {"{{ client_goal — 1 to 2 sentences. Fill from content questionnaire. }}"}
          </p>

          <h3>Design challenge</h3>
          <p>
            {"{{ design_challenge — 1 to 2 sentences. Fill from content questionnaire. }}"}
          </p>
        </div>
      </div>

      <!--
        Additional images available in /public/images/projects/luxury-home-renovation/
        Known files: 2-8-mjEkx90rleFPDG1n.jpg, 3-A3QOoKVygoIkW0VX.jpg, img-YbNNxvoK13FgelX6.jpg
      -->

      <ul class="actions">
        <li><a href={`${baseUrl}portfolio`} class="button primary">Back to Portfolio</a></li>
        <li><a href={`${baseUrl}contact`} class="button">Start Your Project</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>
