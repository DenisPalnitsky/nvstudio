---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Luxury Home Renovation - NV Studio Design"
  description="Luxury Home Renovation - Complete transformation of a 1980s home into a modern luxury residence by NV Studio Design."
  keywords="luxury home renovation, home transformation, architectural renovation, NV Studio Design"
  headerClass="alt style2"
  mainClass={undefined}
>
  <section id="banner" class="style2" slot="banner">
    <div class="inner">
      <span class="image">
        <img
          src="images/projects/luxury-home-renovation/3-A3QOoKVygoIkW0VX.jpg"
          alt="Luxury Home Renovation"
        />
      </span>
      <header class="major">
        <h1>Luxury Home Renovation</h1>
      </header>
      <div class="content">
        <p>
          Complete transformation of a 1980s home into<br />
          a modern luxury residence with contemporary finishes.
        </p>
      </div>
    </div>
  </section>

  <section id="one">
    <div class="inner">
      <header class="major">
        <!-- Content from docs/pages.md Section 8: Individual Project Pages (lines 183-204) -->
        <h2>Individual Project Page Template</h2>
      </header>

      <h3>Purpose</h3>
      <ul>
        <li>Strongest SEO + trust asset</li>
        <li>Prove real experience</li>
      </ul>

      <h3>Content recommendations</h3>
      <ul>
        <li>Project title + year</li>
        <li>City (not exact address)</li>
        <li>Client goals</li>
        <li>Design challenges</li>
        <li>Plans / drawings / renders</li>
        <li>Short narrative</li>
      </ul>

      <h3>Implementation notes</h3>
      <ul>
        <li>One URL per project</li>
        <li>Text is mandatory (not image-only)</li>
        <li>Use consistent structure for all projects</li>
      </ul>

      <ul class="actions">
        <li><a href="portfolio.html" class="button primary">Back to Portfolio</a></li>
        <li><a href="contact.html" class="button">Start Your Project</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>

