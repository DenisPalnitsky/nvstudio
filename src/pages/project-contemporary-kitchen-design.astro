---
import BaseLayout from "../layouts/BaseLayout.astro";
const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Contemporary Kitchen Design - NV Studio Design"
  description="Contemporary Kitchen Design - A sleek modern kitchen renovation featuring premium finishes and smart storage solutions by NV Studio Design."
  keywords="contemporary kitchen design, modern kitchen renovation, interior design, NV Studio Design"
  headerClass="alt style2"
  mainClass={undefined}
>
  <section id="banner" class="style2" slot="banner">
    <div class="inner">
      <span class="image">
        <img
          src="images/projects/contemporary-kitchen-design/4-5-mxB1570PnXh3MKp8.jpg"
          alt="Contemporary Kitchen Design"
        />
      </span>
      <header class="major">
        <h1>Contemporary Kitchen Design</h1>
      </header>
      <div class="content">
        <p>
          A sleek modern kitchen renovation featuring premium finishes,<br />
          smart storage solutions, and open-concept design.
        </p>
      </div>
    </div>
  </section>

  <section id="one">
    <div class="inner">
      <header class="major">
        <!-- Content from docs/pages.md Section 8: Individual Project Pages (lines 183-204) -->
        <h2>Individual Project Page Template</h2>
      </header>

      <h3>Purpose</h3>
      <ul>
        <li>Strongest SEO + trust asset</li>
        <li>Prove real experience</li>
      </ul>

      <h3>Content recommendations</h3>
      <ul>
        <li>Project title + year</li>
        <li>City (not exact address)</li>
        <li>Client goals</li>
        <li>Design challenges</li>
        <li>Plans / drawings / renders</li>
        <li>Short narrative</li>
      </ul>

      <h3>Implementation notes</h3>
      <ul>
        <li>One URL per project</li>
        <li>Text is mandatory (not image-only)</li>
        <li>Use consistent structure for all projects</li>
      </ul>

      <ul class="actions">
        <li><a href={`${baseUrl}portfolio`} class="button primary">Back to Portfolio</a></li>
        <li><a href={`${baseUrl}contact`} class="button">Start Your Project</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>

