---
import BaseLayout from "../layouts/BaseLayout.astro";
const baseUrl = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
  title="Contemporary Kitchen Design - NV Studio Design"
  description="A contemporary kitchen renovation by NV Studio Design. Integrated millwork, premium finishes, and a layout built around how the family cooks and hosts."
  keywords="contemporary kitchen design Toronto, kitchen renovation GTA, modern kitchen Ontario, NV Studio Design"
  headerClass="alt style2"
  mainClass={undefined}
>
  <section id="banner" class="style2" slot="banner">
    <div class="inner">
      <span class="image">
        <img
          src="images/projects/contemporary-kitchen-design/4-5-mxB1570PnXh3MKp8.jpg"
          alt="Contemporary kitchen with integrated millwork and stone surfaces, by NV Studio Design"
        />
      </span>
      <header class="major">
        <h1>Contemporary Kitchen Design</h1>
      </header>
      <div class="content">
        <p>
          A kitchen reworked around how the family actually cooks,<br />
          with premium finishes and integrated millwork resolved into the plan.
        </p>
      </div>
    </div>
  </section>

  <section id="one">
    <div class="inner">
      <div class="row gtr-50">
        <div class="col-8 col-12-medium">
          <h2>Design intent</h2>
          <p>
            A kitchen is a structural room pretending to be casual. It
            has to work as an appliance, a gathering space, and a piece of
            architecture at the same time &mdash; and on a renovation
            that work has to fit inside what&rsquo;s already there.
          </p>
          <p>
            The plan is built around a generous island that doubles as
            prep surface and informal seating. Tall integrated cabinetry
            handles pantry and appliance garages, keeping the counter
            runs deliberately clean. Stone surfaces and warm-toned
            millwork trade off against each other so the room reads
            calm, not cold.
          </p>

          <h2>Key ideas</h2>
          <ul>
            <li>Layout driven by the work triangle, then by sightlines to the rest of the house.</li>
            <li>Integrated appliances so the cabinetry reads as millwork, not as a product lineup.</li>
            <li>Lighting layered across three levels: ambient, task, and accent.</li>
            <li>Finishes specified against real samples, not renders.</li>
          </ul>
        </div>

        <div class="col-4 col-12-medium">
          <h3>Project facts</h3>
          <ul>
            <li><strong>Type:</strong> Kitchen renovation</li>
            <li><strong>Location:</strong> {"{{ city }}"}</li>
            <li><strong>Year:</strong> {"{{ year }}"}</li>
            <li><strong>Size:</strong> {"{{ size_sqft }}"}</li>
            <li><strong>Status:</strong> {"{{ status }}"}</li>
            <li><strong>Services:</strong> Interior design, millwork design</li>
          </ul>

          <h3>Client brief</h3>
          <p>
            {"{{ client_goal — 1 to 2 sentences. Fill from content questionnaire. }}"}
          </p>

          <h3>Design challenge</h3>
          <p>
            {"{{ design_challenge — 1 to 2 sentences. Fill from content questionnaire. }}"}
          </p>
        </div>
      </div>

      <!--
        Additional images available in /public/images/projects/contemporary-kitchen-design/
        Known files: 3_f-mxBr6VXEeBcDpQKR.jpg, 4-5-mxB1570PnXh3MKp8.jpg, fin_kit_7b-A3QpLkleKLt9rJoW.jpg
      -->

      <ul class="actions">
        <li><a href={`${baseUrl}portfolio`} class="button primary">Back to Portfolio</a></li>
        <li><a href={`${baseUrl}contact`} class="button">Start Your Project</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>
