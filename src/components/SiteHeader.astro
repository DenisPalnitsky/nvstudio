---
const { className = "" } = Astro.props;
const headerClass = className?.trim() ? className.trim() : undefined;
const baseUrl = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<header id="header" class={headerClass}>
  <a href={baseUrl} class="logo">
    <img
      src="images/logo.jpg"
      alt="NV Studio Design"
      style="height: 2rem; width: auto; vertical-align: middle; margin-right: 0.5rem;"
    />
    <strong>NV Studio</strong> <span>Design</span>
  </a>
  <nav>
    <a href={baseUrl}>Home</a>
    <a href={`${baseUrl}services`}>Services</a>
    <a href={`${baseUrl}process`}>Process</a>
    <a href={`${baseUrl}portfolio`}>Portfolio</a>
    <a href={`${baseUrl}about`}>About</a>
    <a href={`${baseUrl}contact`}>Contact</a>
    <a href="#menu">Menu</a>
  </nav>
</header>

