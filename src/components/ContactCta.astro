---
const baseUrl = import.meta.env.BASE_URL;
---
<section id="contact">
  <div class="inner">
    <div style="text-align: center; max-width: 50em; margin: 0 auto;">
      <h2>Ready to start your project?</h2>
      <p>Let's discuss your residential architecture needs in the GTA.</p>
      <ul class="actions" style="justify-content: center;">
        <li><a href={`${baseUrl}contact`} class="button primary">Book a Consultation</a></li>
      </ul>
    </div>
  </div>
</section>

